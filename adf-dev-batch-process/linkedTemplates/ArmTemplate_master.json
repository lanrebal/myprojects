{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dev-batch-process"
		},
		"ls_cryptoassets_adls_properties_typeProperties_sasUri_secretName": {
			"type": "string",
			"defaultValue": "kv-cryptoassets-adls"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-dev-apps.vault.azure.net/"
		},
		"ls_kv_database_batch_dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tcp:server-data-dev.database.windows.net,1433"
		},
		"ls_kv_database_batch_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "database_batch_dev"
		},
		"ls_kv_database_batch_dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "server_dev_admin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-dev-batch-process_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_cryptoassets_adls_properties_typeProperties_sasUri_secretName": {
						"value": "[parameters('ls_cryptoassets_adls_properties_typeProperties_sasUri_secretName')]"
					},
					"ls_kv_database_batch_dev_properties_typeProperties_server": {
						"value": "[parameters('ls_kv_database_batch_dev_properties_typeProperties_server')]"
					},
					"ls_kv_database_batch_dev_properties_typeProperties_database": {
						"value": "[parameters('ls_kv_database_batch_dev_properties_typeProperties_database')]"
					},
					"ls_kv_database_batch_dev_properties_typeProperties_userName": {
						"value": "[parameters('ls_kv_database_batch_dev_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}