{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dev-batch-process"
		},
		"ls_cryptoassets_adls_properties_typeProperties_sasUri_secretName": {
			"type": "string",
			"defaultValue": "kv-cryptoassets-adls"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-dev-apps.vault.azure.net/"
		},
		"ls_kv_database_batch_dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tcp:server-data-dev.database.windows.net,1433"
		},
		"ls_kv_database_batch_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "database_batch_dev"
		},
		"ls_kv_database_batch_dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "server_dev_admin"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Batch Process Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Batch Process",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "Batch Process Dataflow",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"Source": {},
									"Sink": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-06-01T03:03:18Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/Batch Process Dataflow')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_database_batch_dev')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_kv_database_batch_dev",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": "dbo",
					"table": "CryptoAssetDataBatch"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_kv_database_batch_dev')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_cryptoassets_adls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"sasUri": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_keyvault",
							"type": "LinkedServiceReference"
						},
						"secretName": "[parameters('ls_cryptoassets_adls_properties_typeProperties_sasUri_secretName')]"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_keyvault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_keyvault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_kv_database_batch_dev')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_kv_database_batch_dev_properties_typeProperties_server')]",
					"database": "[parameters('ls_kv_database_batch_dev_properties_typeProperties_database')]",
					"encrypt": "True",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_kv_database_batch_dev_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_keyvault",
							"type": "LinkedServiceReference"
						},
						"secretName": "kv-database-batch-dev"
					},
					"multipleActiveResultSets": "False"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_keyvault')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Batch Process Dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_cryptoassets_adls",
								"type": "LinkedServiceReference"
							},
							"name": "Source",
							"description": "Import data from ADLS"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_database_batch_dev",
								"type": "DatasetReference"
							},
							"name": "Sink",
							"description": "Sink to Azure SQL Db"
						}
					],
					"transformations": [
						{
							"name": "Select",
							"description": "Select Transformation"
						}
					],
					"scriptLines": [
						"source(output(",
						"          baseAsset as string,",
						"          closePrice as double,",
						"          closeTime as timestamp,",
						"          highPrice as double,",
						"          ignore as boolean,",
						"          lowPrice as double,",
						"          numberOfTrades as integer,",
						"          openPrice as double,",
						"          openTime as timestamp,",
						"          quoteAsset as string,",
						"          quoteAssetVolume as double,",
						"          symbol as string,",
						"          takerBuyBaseAssetVolume as double,",
						"          takerBuyQuoteAssetVolume as double,",
						"          volume as double",
						"     ),",
						"     useSchema: false,",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     moveFiles: ['raw_data','batch_processed'],",
						"     format: 'json',",
						"     fileSystem: 'my-assets',",
						"     folderPath: 'raw_data',",
						"     documentForm: 'documentPerLine') ~> Source",
						"Source select(skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> Select",
						"Select sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> Sink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_cryptoassets_adls')]",
				"[concat(variables('factoryId'), '/datasets/ds_database_batch_dev')]"
			]
		}
	]
}